{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/send-video.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/admin-newsletter.html",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
